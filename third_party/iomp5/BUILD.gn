###########################################################
## SDK

sdk_atom("omp_sdk") {
  domain = "cpp"
  name = "omp"

  tags = [
    "type:compiled_shared",
    "arch:target"
  ]

  output_category = "hee/omp"

  files = []

  # copy all head files into sdk.
  all_files = exec_script("//build/sdk/list_files.sh", [rebase_path("include", root_build_dir)], "list lines")
  foreach(f, all_files) {
    files += [ {
      source = "include/$f"
      dest = "include/$f" } ]
  }

  # copy static libraries.
  files += [
    {
      source = "//third_party/iomp5/prebuild/libiomp5.a"
      dest = "lib/libiomp5.a"
    },
    {
      #//out/arm64/obj/third_party/iomp5/libomp.a
      source = "$target_out_dir/libomp.a"
      dest = "lib/libomp.a"
    }
  ]

  non_sdk_deps = [
    ":omp",
  ]
}
