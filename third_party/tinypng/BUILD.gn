# Do not use the targets in this file unless you need a certain libjpeg
# implementation. Use the meta target //third_party:jpeg instead.

config("config") {
  include_dirs = [ "." ]
}

static_library("tinypng") {
  sources = [
    "pixel.cc",
    "pixel.h",
    "tinypng.cc",
    "tinypng.h",
  ]

  configs += [ ":config" ]

  public_configs = [ ":config" ]

  deps = [
    "//third_party/libpng",
  ]

  public_deps = [
    "//third_party/libpng",
  ]
}
