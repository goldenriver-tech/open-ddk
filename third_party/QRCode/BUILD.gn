import("//build/nebula/nbl_sdk_library.gni")

config("qrcode_config") {
  include_dirs = [ "./include/nbl_qrcode" ]

  defines = [
  ]
}

static_library("libnbl_qrcode") {
  sources = [
    "src/qrcode.c"
  ]

  configs += [ ":qrcode_config" ]

  public_configs = [ ":qrcode_config" ]
}

#################################################
## SDK
#################################################

nbl_sdk_library("libnbl_qrcode_sdk") {
  name = "nbl_qrcode"
  category = "hee"
  hdr_dir = "include"
  libs = [
    "libnbl_qrcode.a",
  ]
  deps = [
    ":libnbl_qrcode",
  ]
}
